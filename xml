<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Session Badge -->
    <TextView
        android:id="@+id/textViewStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:background="@color/card_bg"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="Work Session"
        android:textColor="@color/text_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Progress Ring & Timer -->
    <RelativeLayout
        android:id="@+id/timerContainer"
        android:layout_width="290dp"
        android:layout_height="290dp"
        android:layout_centerInParent="true">

        <ProgressBar
            android:id="@+id/progressBarBg"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="false"
            android:max="1000"
            android:progress="1000"
            android:progressDrawable="@drawable/circular_progress_bg" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="false"
            android:max="1000"
            android:progress="1000"
            android:progressDrawable="@drawable/circular_progress" />

        <TextView
            android:id="@+id/textViewTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="25:00"
            android:textColor="@color/text_white"
            android:textSize="56sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/timerContainer"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonStartPause"
            android:layout_width="140dp"
            android:layout_height="60dp"
            android:layout_marginEnd="12dp"
            android:backgroundTint="@color/work_color"
            android:text="Start"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonReset"
            android:layout_width="140dp"
            android:layout_height="60dp"
            android:backgroundTint="@color/card_bg"
            android:text="Reset"
            android:textAllCaps="false"
            android:textColor="@color/text_muted"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="invisible" />
    </LinearLayout>

</RelativeLayout>
